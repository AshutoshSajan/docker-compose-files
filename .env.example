# Copy to .env and change values. Never commit .env.
# Used by all compose files via ${VAR:-default} substitution.

# --- Image versions (latest stable defaults; override per project as needed) ---
# Examples: POSTGRES_VERSION=17  MONGO_VERSION=7.0  REDIS_VERSION=7.4
#           RABBITMQ_VERSION=4.2-management  ES_VERSION=8.19.21
#           CONFLUENT_VERSION=7.8.10  KAFKA_VERSION=4.2.1
POSTGRES_VERSION=18
MYSQL_VERSION=9
MONGO_VERSION=8
REDIS_VERSION=8
RABBITMQ_VERSION=4.3-management
KAFKA_VERSION=4.3.1
CONFLUENT_VERSION=7.9.9
KAFKA_UI_VERSION=latest
ES_VERSION=9.5.3
CASSANDRA_VERSION=5.0
REAPER_VERSION=3.6.0
PROM_VERSION=v3.14.0
GRAFANA_VERSION=13.2
TIGERBEETLE_VERSION=latest
NGINX_VERSION=1.30-alpine
JULIA_VERSION=1.12

# --- Postgres (pgsql.yml + bitnami-postgres.yml) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
POSTGRES_PORT=5432
BITNAMI_POSTGRES_PORT=5433

# --- MySQL ---
MYSQL_DATABASE=appdb
MYSQL_USER=app
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PORT=3306

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# --- Redis (single, official image; password always required) ---
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# --- Redis master/replica ---
REDIS_MASTER_PASSWORD=changeme-master
REDIS_REPLICA_PASSWORD=changeme-replica
REDIS_MASTER_PORT=6379
REDIS_REPLICA_PORT=6380

# --- RabbitMQ ---
RABBITMQ_USER=user
RABBITMQ_PASSWORD=changeme
RABBITMQ_ERL_COOKIE=changeme-cookie
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Kafka (kafka.yml KRaft + zookeeper-kafka.yml) ---
KAFKA_PORT=9094
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- kafka-gui.yml ---
KAFKA_UI_PORT=8080

# --- Elasticsearch ---
ES_PORT=9200
KIBANA_PORT=5601

# --- Cassandra ---
CASSANDRA_CLUSTER=local-cluster
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1
CASSANDRA_PORT=9042
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# --- Nginx / Julia ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
JULIA_PORT=7777
