# Copy to .env and change values. Never commit .env.
# Used by all compose files via ${VAR:-default} substitution.

# --- Image versions (latest stable defaults; override per project as needed) ---
# Examples: POSTGRES_VERSION=17  MONGO_VERSION=7.0  REDIS_VERSION=7.4
#           RABBITMQ_VERSION=4.2-management  ES_VERSION=8.19.21
#           CONFLUENT_VERSION=7.8.10  KAFKA_VERSION=4.2.1
# Lines tagged `# renovate: ...` are auto-updated by Renovate (see renovate.json).
# renovate: depName=postgres
POSTGRES_VERSION=18
# renovate: depName=mysql
MYSQL_VERSION=9
# renovate: depName=mongo
MONGO_VERSION=8
# renovate: depName=redis
REDIS_VERSION=8
# renovate: depName=rabbitmq
RABBITMQ_VERSION=4.3-management
# renovate: depName=apache/kafka
KAFKA_VERSION=4.3.1
# renovate: depName=confluentinc/cp-kafka
CONFLUENT_VERSION=7.9.9
KAFKA_UI_VERSION=latest
# renovate: depName=elasticsearch/elasticsearch registryUrl=https://docker.elastic.co
ES_VERSION=9.5.3
# renovate: depName=cassandra
CASSANDRA_VERSION=5.0
# renovate: depName=thelastpickle/cassandra-reaper
REAPER_VERSION=3.6.0
# renovate: depName=prom/prometheus
PROM_VERSION=v3.14.0
# renovate: depName=grafana/grafana
GRAFANA_VERSION=13.2
TIGERBEETLE_VERSION=latest
# renovate: depName=nginx
NGINX_VERSION=1.30-alpine
# renovate: depName=julia
JULIA_VERSION=1.12

# --- Web UIs (opt-in `gui` profile: GUI=1 make up-<service>) ---
# renovate: depName=dpage/pgadmin4
PGADMIN_VERSION=9
# renovate: depName=phpmyadmin
PHPMYADMIN_VERSION=5.2
# renovate: depName=mongo-express
MONGO_EXPRESS_VERSION=1.0
REDIS_COMMANDER_VERSION=latest
# Ports (distinct defaults so several GUIs can run together)
PGADMIN_PORT=5050
PHPMYADMIN_PORT=8081
MONGO_EXPRESS_PORT=8082
REDIS_COMMANDER_PORT=8084
REAPER_PORT=8080
# GUI logins (dev only)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme

# --- Postgres (pgsql.yml + postgres-alt.yml) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
POSTGRES_PORT=5432
ALT_POSTGRES_PORT=5433

# --- MySQL ---
MYSQL_DATABASE=appdb
MYSQL_USER=app
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PORT=3306

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# --- Redis (single, official image; password always required) ---
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# --- Redis master/replica ---
REDIS_MASTER_PASSWORD=changeme-master
REDIS_REPLICA_PASSWORD=changeme-replica
REDIS_MASTER_PORT=6379
REDIS_REPLICA_PORT=6380

# --- RabbitMQ ---
RABBITMQ_USER=user
RABBITMQ_PASSWORD=changeme
RABBITMQ_ERL_COOKIE=changeme-cookie
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Kafka (kafka.yml KRaft + zookeeper-kafka.yml) ---
KAFKA_PORT=9094
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- kafka-gui.yml ---
KAFKA_UI_PORT=8080

# --- Elasticsearch ---
ES_PORT=9200
KIBANA_PORT=5601

# --- Cassandra ---
CASSANDRA_CLUSTER=local-cluster
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1
CASSANDRA_PORT=9042
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# --- Nginx / Julia ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
JULIA_PORT=7777
